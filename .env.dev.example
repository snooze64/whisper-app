# Development Environment Configuration
# Copy this file to .env.dev and adjust values as needed
# Usage: docker-compose -f docker-compose.dev.yml --env-file .env.dev up

# ================================
# Database Configuration
# ================================
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=whisper
DATABASE_URL=postgresql://user:password@postgres:5432/whisper

# ================================
# Redis Configuration
# ================================
REDIS_URL=redis://redis:6379/0

# ================================
# Celery Configuration
# ================================
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ================================
# JWT Authentication
# ================================
SECRET_KEY=dev-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ================================
# CORS Configuration
# ================================
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:5174","http://localhost:8001"]

# ================================
# LDAP Configuration (Mock auth enabled for development)
# ================================
LDAP_SERVER=ldap://ldap-server:389
LDAP_BASE_DN=dc=example,dc=com
LDAP_USER_DN_TEMPLATE=uid={username},ou=users,dc=example,dc=com
USE_MOCK_AUTH=true

# ================================
# Whisper Configuration
# ================================
# Available models: tiny, base, small, medium, large-v2, large-v3, large-v3-turbo
DEFAULT_WHISPER_MODEL=large-v3-turbo

# Default language (ja=Japanese, en=English, auto=auto-detect)
DEFAULT_LANGUAGE=ja

# Whisper backend: "openai-whisper" or "transformers"
# - openai-whisper: Original OpenAI Whisper implementation (faster)
# - transformers: HuggingFace transformers implementation (CUDA 11.4 compatible)
WHISPER_BACKEND=openai-whisper

# GPU Memory threshold in MB (for GPU availability checking)
GPU_MEMORY_THRESHOLD_MB=10000

# ================================
# File Management
# ================================
# Maximum file size in bytes (1GB = 1073741824)
MAX_FILE_SIZE=1073741824

# File retention period in hours
FILE_RETENTION_HOURS=24

# ================================
# Frontend Configuration
# ================================
VITE_API_URL=http://localhost:8001

# ================================
# Proxy Configuration (Optional)
# ================================
# Uncomment and set if you need to use a proxy
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1,postgres,redis
