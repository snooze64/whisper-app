# Project
PROJECT_NAME=Whisper Transcription API
VERSION=1.0.0
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# CORS
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database
DATABASE_URL=postgresql://user:password@postgres:5432/whisper

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# LDAP Authentication
LDAP_SERVER=ldap://ldap-server:389
LDAP_BASE_DN=dc=example,dc=com
LDAP_USER_DN_TEMPLATE=uid={username},ou=users,dc=example,dc=com

# JWT
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# File Storage
UPLOAD_DIR=/data/uploads
RESULT_DIR=/data/results
TEMP_DIR=/data/temp
MAX_FILE_SIZE=1073741824
FILE_RETENTION_HOURS=24

# Whisper
DEFAULT_WHISPER_MODEL=large-v3-turbo
DEFAULT_LANGUAGE=ja

# GPU
CUDA_VISIBLE_DEVICES=0
GPU_MEMORY_THRESHOLD_MB=10000

# Future: OpenAI API (for LLM integration)
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
