# GPU Production Environment Configuration
#
# クイックスタート:
#   1. このファイルを .env.gpu にコピー: cp .env.gpu.example .env.gpu
#   2. すべての CHANGE_ME を実際の本番環境の値に置き換える
#   3. GPU設定を確認（CUDA_VISIBLE_DEVICES, GPU_MEMORY_THRESHOLD_MB）
#   4. 起動: docker-compose -f docker-compose.gpu.yml --env-file .env.gpu up -d
#
# 必須変更項目:
#   - POSTGRES_USER, POSTGRES_PASSWORD (データベース認証情報)
#   - SECRET_KEY (JWT署名用の秘密鍵)
#   - LDAP_SERVER, LDAP_BASE_DN (LDAP認証設定)
#   - VITE_API_URL (アクセス先URL、例: http://192.168.1.100 など)
#   - CUDA_VISIBLE_DEVICES (使用するGPUの指定)
#
# オプション変更項目:
#   - Port Configuration (ポート競合がある場合のみ)
#   - GPU_MEMORY_THRESHOLD_MB (GPUメモリに応じて調整)

# ================================
# Database Configuration
# ================================
# 【POSTGRES_USER, POSTGRES_PASSWORD は必ず変更してください】
# DATABASE_URLはDockerネットワーク内でのコンテナ間通信用です
# - "postgres" はコンテナ名
# - "5432" はコンテナ内ポート（通常変更不要）
# - Nginxを経由するため、外部からの直接アクセスはありません
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=whisper
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
POSTGRES_MAX_CONNECTIONS=100

# ================================
# Redis Configuration
# ================================
# 【通常は変更不要】
# REDIS_URLはDockerネットワーク内でのコンテナ間通信用です
# - "redis" はコンテナ名
# - "6379" はコンテナ内ポート
REDIS_URL=redis://redis:6379/0

# ================================
# Celery Configuration
# ================================
# 【通常は変更不要】
# CeleryはRedisをメッセージブローカーとして使用します
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ================================
# JWT Authentication
# ================================
# IMPORTANT: Generate a strong random SECRET_KEY for production
# Example: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_GENERATE_STRONG_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ================================
# CORS Configuration
# ================================
# フロントエンドのアクセス元を許可するリスト
# 現在はHTTPのみなので、httpで指定してください
# 例: ["http://192.168.1.100","http://whisper-app.local"]
BACKEND_CORS_ORIGINS=["http://your-server-ip"]

# ================================
# LDAP Configuration (Production)
# ================================
LDAP_SERVER=ldap://your-ldap-server.example.com:389
LDAP_BASE_DN=dc=example,dc=com
LDAP_USER_DN_TEMPLATE=uid={username},ou=users,dc=example,dc=com
USE_MOCK_AUTH=false

# ================================
# GPU Configuration
# ================================
# Specify which GPU(s) to use (comma-separated for multiple GPUs)
# Examples:
#   - Single GPU: CUDA_VISIBLE_DEVICES=0
#   - Multiple GPUs: CUDA_VISIBLE_DEVICES=0,1
#   - All GPUs: CUDA_VISIBLE_DEVICES=all (or leave empty)
CUDA_VISIBLE_DEVICES=0

# GPU memory threshold in MB (minimum free VRAM required to start transcription)
# Adjust based on your GPU's total VRAM:
#   - For 8GB GPU: 4000-5000
#   - For 16GB GPU: 8000-10000
#   - For 24GB+ GPU: 10000-12000
GPU_MEMORY_THRESHOLD_MB=10000

# ================================
# Whisper Configuration
# ================================
# Available models: tiny, base, small, medium, large-v2, large-v3, large-v3-turbo
# For GPU: large-v3 or large-v3-turbo recommended for best quality
DEFAULT_WHISPER_MODEL=large-v3-turbo

# Default language (ja=Japanese, en=English, auto=auto-detect)
DEFAULT_LANGUAGE=ja

# Whisper backend: "openai-whisper" or "transformers"
# - openai-whisper: Original OpenAI Whisper implementation (requires CUDA 11.8+)
# - transformers: HuggingFace transformers implementation (CUDA 11.4+ compatible)
# For GPU production:
#   - Use "openai-whisper" if you have CUDA 11.8 or 12.x
#   - Use "transformers" if you have CUDA 11.4 (older drivers)
WHISPER_BACKEND=openai-whisper

# ================================
# File Management
# ================================
# Maximum file size in bytes (1GB = 1073741824)
MAX_FILE_SIZE=1073741824

# File retention period in hours
FILE_RETENTION_HOURS=24

# ================================
# SSL/Domain Configuration
# ================================
# 【HTTPのみで使用する場合は設定不要】
# 現在の設定ではHTTPのみ（SSL/HTTPS なし）で動作します
# SSL/HTTPSが必要な場合は、docker-compose.gpu.ymlのnginx設定を
# nginx.prod.nossl.conf から nginx.prod.conf に変更し、以下を設定してください
#
# DOMAIN_NAME=your-domain.com
# SSL_EMAIL=admin@your-domain.com

# ================================
# Backup Configuration
# ================================
# Number of days to retain database backups
BACKUP_RETENTION_DAYS=7

# ================================
# Port Configuration
# ================================
# 【通常は変更不要】標準的なHTTP/HTTPSポートを使用します
# ポート競合がある場合や、非標準ポートを使用する必要がある場合のみ変更してください
#
# 注意: ポート番号を変更した場合は、以下も合わせて変更が必要です
#   - VITE_API_URL (本番ドメインのURLにポート番号を含める)
#   - ファイアウォール設定（変更後のポートを開放）
#   - Let's Encrypt証明書取得（443以外の場合は追加設定が必要）
#
# 本番環境での推奨: 80/443 をそのまま使用（SSL証明書取得が容易）
NGINX_HTTP_PORT=80            # HTTP (標準ポート)
NGINX_HTTPS_PORT=443          # HTTPS (標準ポート)

# ================================
# Frontend Configuration
# ================================
# フロントエンドがバックエンドAPIに接続するためのURL
# 現在はHTTPのみの設定なので、httpで指定してください
# 例: http://192.168.1.100 または http://whisper-app.local
VITE_API_URL=http://your-server-ip

# ================================
# Proxy Configuration (Optional)
# ================================
# Uncomment and set if your production environment requires a proxy
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1,postgres,redis
