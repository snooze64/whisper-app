# ========================================
# Frontend Environment Variables
# ========================================
# Copy this file to .env for local development without Docker Compose
# When using Docker Compose, environment variables are set in docker-compose.yml

# ========================================
# API Configuration
# ========================================
# Backend API base URL
# Development (Docker Compose): http://localhost:8001
# Development (local backend): http://localhost:8000
# Production: https://your-domain.com (set during build)
VITE_API_URL=http://localhost:8001

# ========================================
# Proxy Configuration (Optional)
# ========================================
# Uncomment and configure if behind corporate proxy
# These settings apply during npm install and build
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1

# ========================================
# Usage Notes
# ========================================
#
# For Docker Compose development:
#   Environment variables are automatically set in docker-compose.yml
#   You don't need to create .env file
#
# For standalone development (npm run dev):
#   1. Copy this file: cp .env.example .env
#   2. Adjust VITE_API_URL if needed
#   3. Run: npm run dev
#
# For production build:
#   Set VITE_API_URL during build:
#   VITE_API_URL=https://api.example.com npm run build
#
