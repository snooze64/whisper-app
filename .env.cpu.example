# CPU Production Environment Configuration
# Copy this file to .env.cpu and replace all CHANGE_ME values with actual production values
# Usage: docker-compose -f docker-compose.cpu.yml --env-file .env.cpu up -d

# ================================
# Database Configuration
# ================================
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=whisper
DATABASE_URL=postgresql://CHANGE_ME:CHANGE_ME_STRONG_PASSWORD@postgres:5432/whisper
POSTGRES_MAX_CONNECTIONS=100

# ================================
# Redis Configuration
# ================================
REDIS_URL=redis://redis:6379/0

# ================================
# Celery Configuration
# ================================
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ================================
# JWT Authentication
# ================================
# IMPORTANT: Generate a strong random SECRET_KEY for production
# Example: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_GENERATE_STRONG_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ================================
# CORS Configuration
# ================================
# Adjust to match your production domain(s)
BACKEND_CORS_ORIGINS=["https://your-domain.com"]

# ================================
# LDAP Configuration (Production)
# ================================
LDAP_SERVER=ldap://your-ldap-server.example.com:389
LDAP_BASE_DN=dc=example,dc=com
LDAP_USER_DN_TEMPLATE=uid={username},ou=users,dc=example,dc=com
USE_MOCK_AUTH=false

# ================================
# Whisper Configuration
# ================================
# Available models: tiny, base, small, medium, large-v2, large-v3, large-v3-turbo
# For CPU: large-v3-turbo recommended (faster), or medium for lower resource usage
DEFAULT_WHISPER_MODEL=large-v3-turbo

# Default language (ja=Japanese, en=English, auto=auto-detect)
DEFAULT_LANGUAGE=ja

# Whisper backend: "openai-whisper" or "transformers"
# - openai-whisper: Original OpenAI Whisper implementation (faster on CPU)
# - transformers: HuggingFace transformers implementation (CUDA 11.4 compatible)
# For CPU production, openai-whisper is typically faster
WHISPER_BACKEND=openai-whisper

# ================================
# File Management
# ================================
# Maximum file size in bytes (1GB = 1073741824)
MAX_FILE_SIZE=1073741824

# File retention period in hours
FILE_RETENTION_HOURS=24

# ================================
# SSL/Domain Configuration
# ================================
DOMAIN_NAME=your-domain.com
SSL_EMAIL=admin@your-domain.com

# ================================
# Backup Configuration
# ================================
# Number of days to retain database backups
BACKUP_RETENTION_DAYS=7

# ================================
# Frontend Configuration
# ================================
# Set to your production domain/URL
VITE_API_URL=https://your-domain.com

# ================================
# Proxy Configuration (Optional)
# ================================
# Uncomment and set if your production environment requires a proxy
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1,postgres,redis
