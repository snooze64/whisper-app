# Development Environment Configuration
#
# クイックスタート:
#   1. このファイルを .env.dev にコピー: cp .env.dev.example .env.dev
#   2. 起動: docker-compose -f docker-compose.dev.yml --env-file .env.dev up -d
#   3. ブラウザでアクセス: http://localhost:5174
#
# 注意: 通常はデフォルト値のまま使用できます。変更が必要なのは以下の場合のみ:
#   - ポート競合が発生した場合（Port Configuration セクション参照）
#   - プロキシ環境で使用する場合（Proxy Configuration セクション参照）

# ================================
# Database Configuration
# ================================
# 【通常は変更不要】
# DATABASE_URLはDockerネットワーク内でのコンテナ間通信用です
# - "postgres" はコンテナ名
# - "5432" はコンテナ内ポート（通常変更不要）
# - POSTGRES_HOST_PORT（5434）はホストマシンからのアクセス用
#
# 注意: コンテナ内ポートを変更したい場合（レアケース）:
#   1. docker-compose.dev.yml の ports を変更
#   2. このDATABASE_URLのポート番号も変更
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=whisper
DATABASE_URL=postgresql://user:password@postgres:5432/whisper

# ================================
# Redis Configuration
# ================================
# 【通常は変更不要】
# REDIS_URLはDockerネットワーク内でのコンテナ間通信用です
# - "redis" はコンテナ名
# - "6379" はコンテナ内ポート（通常変更不要）
# - REDIS_HOST_PORT（6380）はホストマシンからのアクセス用
REDIS_URL=redis://redis:6379/0

# ================================
# Celery Configuration
# ================================
# 【通常は変更不要】
# CeleryはRedisをメッセージブローカーとして使用します
# REDIS_URLと同じコンテナ内ポート（6379）を使用
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ================================
# JWT Authentication
# ================================
SECRET_KEY=dev-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ================================
# CORS Configuration
# ================================
# 【ポート変更時は要更新】フロントエンドとバックエンドのポート番号を含めてください
# CORS (Cross-Origin Resource Sharing) で許可するオリジンのリスト
# フロントエンドからバックエンドへのAPI呼び出しを許可するために必要
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:5174","http://localhost:8001"]

# ================================
# LDAP Configuration (Mock auth enabled for development)
# ================================
LDAP_SERVER=ldap://ldap-server:389
LDAP_BASE_DN=dc=example,dc=com
LDAP_USER_DN_TEMPLATE=uid={username},ou=users,dc=example,dc=com
USE_MOCK_AUTH=true

# ================================
# Whisper Configuration
# ================================
# Available models: tiny, base, small, medium, large-v2, large-v3, large-v3-turbo
DEFAULT_WHISPER_MODEL=large-v3-turbo

# Default language (ja=Japanese, en=English, auto=auto-detect)
DEFAULT_LANGUAGE=ja

# Whisper backend: "openai-whisper" or "transformers"
# - openai-whisper: Original OpenAI Whisper implementation (faster)
# - transformers: HuggingFace transformers implementation (CUDA 11.4 compatible)
WHISPER_BACKEND=openai-whisper

# GPU Memory threshold in MB (for GPU availability checking)
GPU_MEMORY_THRESHOLD_MB=10000

# ================================
# File Management
# ================================
# Maximum file size in bytes (1GB = 1073741824)
MAX_FILE_SIZE=1073741824

# File retention period in hours
FILE_RETENTION_HOURS=24

# ================================
# Port Configuration
# ================================
# 【通常は変更不要】デフォルト値のままで動作します
# ポート競合が発生した場合のみ、以下の値を変更してください
#
# 注意: ポート番号を変更した場合は、以下も合わせて変更が必要です
#   - VITE_API_URL (フロントエンドからのAPI接続先)
#   - BACKEND_CORS_ORIGINS (CORS許可リスト)
#
# ホストマシンからアクセスする際のポート番号:
POSTGRES_HOST_PORT=5434       # PostgreSQL (コンテナ内: 5432)
REDIS_HOST_PORT=6380          # Redis (コンテナ内: 6379)
BACKEND_HOST_PORT=8001        # FastAPI Backend (コンテナ内: 8000)
FRONTEND_HOST_PORT=5174       # Vite Dev Server (コンテナ内: 5173)

# ================================
# Frontend Configuration
# ================================
# 【ポート変更時は要更新】BACKEND_HOST_PORT と一致させてください
# フロントエンドがバックエンドAPIに接続するためのURL
VITE_API_URL=http://localhost:8001

# ================================
# Proxy Configuration (Optional)
# ================================
# Uncomment and set if you need to use a proxy
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1,postgres,redis
