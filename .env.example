# Production Environment Variables Template
#
# クイックスタート:
#   1. このファイルを .env にコピー: cp .env.example .env
#   2. すべての CHANGE_THIS を実際の本番環境の値に置き換える
#   3. どのdocker-compose.*.ymlを使用するか決定:
#      - docker-compose.dev.yml (開発環境)
#      - docker-compose.cpu.yml (CPU本番環境)
#      - docker-compose.gpu.yml (GPU本番環境)
#
# 注意: このファイルは汎用テンプレートです
#   環境別の詳細な設定は以下を参照してください:
#   - 開発環境: .env.dev.example
#   - CPU本番環境: .env.cpu.example
#   - GPU本番環境: .env.gpu.example

# ========================================
# Database Configuration
# ========================================
# 【POSTGRES_USER, POSTGRES_PASSWORD は必ず変更してください】
# DATABASE_URLはDockerネットワーク内でのコンテナ間通信用です
# - "postgres" はコンテナ名
# - "5432" はコンテナ内ポート（通常変更不要）
POSTGRES_USER=whisper_user
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
POSTGRES_DB=whisper
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# ========================================
# Redis Configuration
# ========================================
# 【通常は変更不要】
# REDIS_URLはDockerネットワーク内でのコンテナ間通信用です
# - "redis" はコンテナ名
# - "6379" はコンテナ内ポート
REDIS_URL=redis://redis:6379/0

# ========================================
# Celery Configuration
# ========================================
# 【通常は変更不要】
# CeleryはRedisをメッセージブローカーとして使用します
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ========================================
# Security
# ========================================
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_THIS_TO_RANDOM_SECRET_KEY

# JWT Configuration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ========================================
# CORS Configuration
# ========================================
# Comma-separated list of allowed origins
BACKEND_CORS_ORIGINS=["https://yourdomain.com"]

# ========================================
# File Storage Configuration
# ========================================
# Maximum file size in bytes (default: 1GB)
MAX_FILE_SIZE=1073741824
# File retention period in hours (default: 24 hours)
FILE_RETENTION_HOURS=24

# ========================================
# LDAP Authentication
# ========================================
LDAP_SERVER=ldap://your-ldap-server:389
LDAP_BASE_DN=dc=example,dc=com
LDAP_USER_DN_TEMPLATE=uid={username},ou=users,dc=example,dc=com

# Set to true to use mock authentication (development only)
USE_MOCK_AUTH=false

# ========================================
# Whisper Configuration
# ========================================
# Default Whisper model (large-v3, large-v3-turbo)
DEFAULT_WHISPER_MODEL=large-v3-turbo
# Default language for transcription
DEFAULT_LANGUAGE=ja

# ========================================
# GPU Configuration
# ========================================
# GPU device IDs (comma-separated)
CUDA_VISIBLE_DEVICES=0
# Minimum free GPU memory (MB) required to start a task
GPU_MEMORY_THRESHOLD_MB=10000

# ========================================
# SSL/TLS Configuration
# ========================================
# Domain name for SSL certificate
DOMAIN_NAME=yourdomain.com
# Email for Let's Encrypt notifications
SSL_EMAIL=admin@yourdomain.com

# ========================================
# Backup Configuration
# ========================================
# Number of days to keep database backups
BACKUP_RETENTION_DAYS=7

# ========================================
# Monitoring (Optional)
# ========================================
# Sentry DSN for error tracking
SENTRY_DSN=

# ========================================
# Email Notifications (Optional)
# ========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@yourdomain.com

# ========================================
# Frontend Configuration
# ========================================
# Frontend API URL - used during build time
# Development: http://localhost:8001
# Production: Should match your domain (e.g., https://yourdomain.com or https://api.yourdomain.com)
VITE_API_URL=https://yourdomain.com

# ========================================
# Application Settings
# ========================================
# Application environment (development, staging, production)
ENVIRONMENT=production
# Debug mode (true/false) - NEVER set to true in production
DEBUG=false
# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ========================================
# Proxy Configuration (Optional)
# ========================================
# Uncomment and configure if behind corporate proxy
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1,postgres,redis,backend,celery-worker,frontend-dev
